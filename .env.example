# Copy to .env for Docker Compose only. Never commit your filled-in file.
# Keep loopback for local access, or choose a specific private LAN interface.
RIPE_BIND_IP=127.0.0.1
RIPE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
RIPE_APPDATA=/mnt/user/appdata/ripe
# Verify the Docker socket group with stat -c '%g' /var/run/docker.sock.
DOCKER_GID=0
# Optional: require this shared token for Settings and all changes (leave empty for no login).
RIPE_UI_TOKEN=

# Choose your IANA timezone; persisted Settings can override this initial value.
TZ=UTC
# Optional integrations are disabled until their URLs are configured.
# Prefer Settings → Connect Home Assistant; these remain legacy fallbacks.
HA_URL=
HA_TOKEN=
GITHUB_TOKEN=
GEMINI_API_KEY=
OLLAMA_URL=
LOCAL_MODEL=qwen3:8b
GEMINI_MODEL=gemini-2.5-flash
# Use a URL reachable by notification recipients when notifications are enabled.
DASHBOARD_URL=http://localhost:8087
