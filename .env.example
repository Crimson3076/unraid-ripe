# Copy to .env for Docker Compose only. Never commit your filled-in file.
# Safe Compose default: loopback. Set NODE2's LAN IP to use another LAN device.
RIPE_BIND_IP=127.0.0.1
RIPE_ALLOWED_HOSTS=localhost,127.0.0.1,::1,192.168.0.83,node2,NODE2
RIPE_APPDATA=/mnt/user/appdata/ripe
# Socket group on Unraid is normally 0; verify with stat -c '%g' /var/run/docker.sock.
DOCKER_GID=0

# Use an IANA timezone matching NODE2; Settings can override it.
TZ=America/New_York
HA_URL=http://192.168.0.61:8123
HA_TOKEN=
GITHUB_TOKEN=
GEMINI_API_KEY=
OLLAMA_URL=http://192.168.0.83:11434
LOCAL_MODEL=qwen3:8b
GEMINI_MODEL=gemini-2.5-flash
